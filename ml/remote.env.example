# Copy to ml/remote.env on the MacBook (gitignored).

# File Sharing (default, no SSH): the mini's repo mounted in Finder (⌘K → smb://<mini>.local → op-tcg-ar).
MINI_SHIPPED=/Volumes/op-tcg-ar/ml/shipped

# SSH instead (optional; also enables make train-remote). Used only when MINI_SHIPPED is not set.
# MINI_HOST=you@mac-mini.local      # "local" = this Mac also does the ML work
# MINI_REPO=~/github/op-tcg-ar
